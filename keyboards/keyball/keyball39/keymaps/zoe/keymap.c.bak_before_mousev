/*********************************
 * OLED (左右とも縦向き)          *
 *********************************
 * OLED は縦長に取り付けられているので、左右とも 90 度回転して縦向き (横5文字 x 縦16行) で表示する。
 * 左手 (マスター): キーとレイヤ         右手 (スレーブ): トラックボール
 *   Key                                  Ball
 *   R3C4      押したキーの位置           x   移動量 x
 *   Teams     押したキーの動作 (2行)     y   移動量 y
 *    Mute     ホールド時は Ctrl など     CPI
 *   L.2..     レイヤ 1〜4                700
 *   TWIN0     LED パターン + 番号        AML ON/OFF
 *   -----                                550 タイムアウト(ms)
 * 右手は Ball・CPI・AML を自分では持っていないので、左手から送る (oled_sync)。
 */
#ifdef OLED_ENABLE

#    include "lib/oledkit/oledkit.h"
#    include "transactions.h"   // 左右の通信 (oled_sync)

// 縦向きの OLED は 1行5文字 x 16行。行末で自動的に次の行へ進むので、
// 改行(oled_advance_page)は使わず、文字数を数えて行を管理する
#define OLED_LINE_CHARS 5
#define OLED_LINES      16
static uint8_t oled_col, oled_row;
static uint8_t oled_wrap;   // 行末に来たとき次の行へ折り返してよい回数 (キー名の2行表示用)

oled_rotation_t oled_init_user(oled_rotation_t rotation) {
    return OLED_ROTATION_90;   // 左右とも縦向き (文字の上が奥側になる向き)
}

static void put(char c) {
    if (oled_col >= OLED_LINE_CHARS) {
        if (!oled_wrap) return;                // はみ出し防止(次の行に回り込ませない)
        oled_wrap--;
        oled_set_cursor(0, ++oled_row);
        oled_col = 0;
    }
    oled_write_char(c, false);
    oled_col++;
}

static void put_P(const char *s) {
    char c;
    while ((c = pgm_read_byte(s++))) put(c);
}

static void put_hex(uint8_t v) {
    v &= 0x0F;
    put(v < 10 ? '0' + v : 'A' + v - 10);
}

// 数値(-255〜255)を右詰め w 桁で表示。負数は最上位桁の左に '-'
// 表示する値はすべて3桁以内に収まる(CPI は100単位、AML は10ms単位で渡す)ので 8bit で計算して容量節約
static void put_num(int16_t v, uint8_t w) {
    uint8_t n = v < 0 ? -v : v;
    char    h = '0', t = '0';
    while (n >= 100) { n -= 100; h++; }
    while (n >= 10)  { n -= 10;  t++; }
    uint8_t len = (v < 0) + (h > '0' ? 3 : t > '0' ? 2 : 1);
    while (w-- > len) put(' ');
    if (v < 0) put('-');
    if (h > '0') put(h);
    if (h > '0' || t > '0') put(t);
    put('0' + n);
}

static void end_line(void) {
    while (oled_col < OLED_LINE_CHARS) put(' ');
    oled_col = 0;
    if (oled_row < OLED_LINES - 1) oled_set_cursor(0, ++oled_row);
    else oled_row = OLED_LINES;
}

static void begin_screen(void) {
    oled_set_cursor(0, 0);
    oled_col = oled_row = oled_wrap = 0;
}

static void clear_rest(void) {
    while (oled_row < OLED_LINES) end_line();
}

// "\0" 区切りで詰めた名前一覧から n 番目を表示 (固定長配列より容量が小さい)
static void put_nth(const char *list, uint8_t n) {
    while (n--) while (pgm_read_byte(list++));
    put_P(list);
}

// 修飾キー名 (0:Ctrl 1:Shift 2:Alt 3:GUI)。Mac モード時は Alt→Opt, GUI→Cmd
static void put_mod(uint8_t i) {
    static const char names[] PROGMEM = "Ctrl\0Shift\0Alt\0Win\0Ctrl\0Shift\0Opt\0Cmd";
    put_nth(names, (TOG_STATUS_WINMAC ? 4 : 0) + (i & 3));
}

// 5bit の修飾ビット(MT や S() など)を "Ctrl+Shift" のように表示 (左右は区別しない)
static void put_mods(uint8_t mods) {
    bool first = true;
    for (uint8_t i = 0; i < 4; i++) {
        if (mods & (1 << i)) {
            if (!first) put('+');
            put_mod(i);
            first = false;
        }
    }
}

// 基本キーコード(0x00〜0xFF)の名前。JIS 配列の刻印で表示
static void put_basic(uint8_t kc) {
    static const char n28[] PROGMEM =   // 0x28〜0x39
        "Enter\0Esc\0BkSp\0Tab\0Space\0-\0^\0@\0[\0]\0]\0;\0:\0Zen/Han\0,\0.\0/\0Caps";
    static const char n46[] PROGMEM =   // 0x46〜0x52
        "PrtSc\0ScrLk\0Pause\0Ins\0Home\0PgUp\0Del\0End\0PgDn\0Right\0Left\0Down\0Up";
    static const char n87[] PROGMEM =   // 0x87〜0x8B
        "\\\0Kana\0Yen\0Henkan\0Muhen";
    if (kc == KC_NO) {
        put_P(PSTR("(none)"));
    } else if (kc >= KC_A && kc <= KC_Z) {
        put('A' + kc - KC_A);
    } else if (kc >= KC_1 && kc <= KC_0) {
        put(kc == KC_0 ? '0' : '1' + kc - KC_1);
    } else if (kc >= KC_ENTER && kc <= KC_CAPS_LOCK) {
        put_nth(n28, kc - KC_ENTER);
    } else if ((kc >= KC_F1 && kc <= KC_F12) || (kc >= KC_F13 && kc <= KC_F24)) {
        uint8_t n = kc <= KC_F12 ? kc - KC_F1 + 1 : kc - KC_F13 + 13;
        put('F');
        put_num(n, n < 10 ? 1 : 2);
    } else if (kc >= KC_PRINT_SCREEN && kc <= KC_UP) {
        put_nth(n46, kc - KC_PRINT_SCREEN);
    } else if (kc == KC_APPLICATION) {
        put_P(PSTR("App"));
    } else if (kc >= KC_INTERNATIONAL_1 && kc <= KC_INTERNATIONAL_5) {
        put_nth(n87, kc - KC_INTERNATIONAL_1);
    } else if (kc == KC_LANGUAGE_1) {
        put_P(PSTR("Kana"));
    } else if (kc == KC_LANGUAGE_2) {
        put_P(PSTR("Eisu"));
    } else if (kc == MS_BTN1) {
        put_P(PSTR("Click L"));
    } else if (kc == MS_BTN2) {
        put_P(PSTR("Click R"));
    } else if (kc == MS_BTN3) {
        put_P(PSTR("Click M"));
    } else if (kc >= KC_LEFT_CTRL && kc <= KC_RIGHT_GUI) {
        put_mod(kc - KC_LEFT_CTRL);                 // 左右は区別せず表示 (容量節約)
    } else {
        put_P(PSTR("KC"));
        put_hex(kc >> 4);
        put_hex(kc);
    }
}

// zoe のカスタムキー名。enum custom_keycodes と同じ順番で並べること
// (WM_LGUI / WM_LCTL は Win/Mac で送るキーが変わるので put_tap() で別処理、ここは空)
static const char user_names[] PROGMEM =
    "To MAIN\0Win Mode\0Mac Mode\0IME Toggle\0\0\0Back\0Forward\0"
    "(\0)\0{\0}\0[\0]\0_\0; :\0' \"\0+ *\0Precision\0Teams Mute\0-\0" "0 =";
_Static_assert(JS_0EQL - MAIN == 21, "user_names の並びを enum custom_keycodes に合わせて更新すること");

// Keyball のキー名 (KBC_RST=QK_KB_0 〜 AML_D50=QK_KB_12)
static const char kb_names[] PROGMEM =
    "Cfg Reset\0Cfg Save\0CPI+100\0CPI-100\0CPI+1000\0CPI-1000\0"
    "Scroll Tog\0Scroll\0ScrDiv+\0ScrDiv-\0AML On/Off\0AML+50ms\0AML-50ms";

// LED のキー名 (UG_TOGG 〜 UG_VALD)
static const char ug_names[] PROGMEM =
    "LED On/Off\0LED Next\0LED Prev\0Hue+\0Hue-\0Sat+\0Sat-\0Bright+\0Bright-";

static const char layer_names[] PROGMEM = "MAIN\0MOUSE\0NUM\0FUNC\0ADJ1\0ADJ2";

// 押したキーの動作を表示。タップ/ホールドのキーは、実際にホールドしたときはホールド側の動作を出す
static void put_tap(uint16_t kc) {
    if (last_key_held && IS_QK_MOD_TAP(kc)) {           // ホールド: 修飾キー名 ("Ctrl" など)
        put_mods(QK_MOD_TAP_GET_MODS(kc));
    } else if (last_key_held && IS_QK_LAYER_TAP(kc)) {  // ホールド: "NUM layer" など
        put_nth(layer_names, QK_LAYER_TAP_GET_LAYER(kc));
        put_P(PSTR(" layer"));
    } else if (kc == AT_MS) {                                  // LALT_T(KC_F23) のタップは MOUSE へ移動
        put_P(PSTR("To MOUSE"));
    } else if (IS_QK_MOD_TAP(kc)) {
        put_basic(QK_MOD_TAP_GET_TAP_KEYCODE(kc));
    } else if (IS_QK_LAYER_TAP(kc)) {
        put_basic(QK_LAYER_TAP_GET_TAP_KEYCODE(kc));
    } else if (IS_QK_MODS(kc)) {                        // S(KC_2) など → "Shift+2"
        put_mods(QK_MODS_GET_MODS(kc));
        put('+');
        put_basic(QK_MODS_GET_BASIC_KEYCODE(kc));
    } else if (kc == WM_LGUI) {                         // Win: Winキー / Mac: Control
        put_mod(TOG_STATUS_WINMAC ? 0 : 3);
    } else if (kc == WM_LCTL) {                         // Win: Control / Mac: Command
        put_mod(TOG_STATUS_WINMAC ? 3 : 0);
    } else if (kc >= MAIN && kc <= JS_0EQL) {
        put_nth(user_names, kc - MAIN);
    } else if (kc >= QK_KB_0 && kc <= AML_D50) {
        put_nth(kb_names, kc - QK_KB_0);
    } else if (kc >= QK_UNDERGLOW_TOGGLE && kc <= QK_UNDERGLOW_VALUE_DOWN) {
        put_nth(ug_names, kc - QK_UNDERGLOW_TOGGLE);
#    ifdef RGBLIGHT_ENABLE
    } else if (kc >= RGB_MODE_PLAIN && kc <= RGB_MODE_TWINKLE) {   // RGB_M_* → "LED:TWINKLE"
        uint8_t i = pgm_read_byte(&rgb_key_to_idx[kc - RGB_MODE_PLAIN]);
        put_P(PSTR("LED:"));
        if (i != 0xFF) put_P(rgb_mode_name[i]);
#    endif
    } else if (kc < 0x100) {
        put_basic(kc);
    } else {                                            // 上記以外は 16進コード
        put_P(PSTR("Code "));
        for (int8_t sh = 12; sh >= 0; sh -= 4) put_hex(kc >> sh);
    }
}

// 右手の OLED 表示用に、左手から送る情報 (右手は Ball・CPI・AML を自分では持っていない)
typedef struct {
    int8_t  x, y;   // ボールの移動量 (左手が PC へ送った値)
    uint8_t cpi;    // CPI (100単位)
    uint8_t aml;    // bit7: AML の ON/OFF, bit0-6: タイムアウト (10ms単位)
} oled_sync_t;
static oled_sync_t oled_sync;

// 右手側: 左手から届いた情報を保存するだけ (分割通信の割り込み内で呼ばれるので重い処理はしない)
static void oled_sync_handler(uint8_t in_len, const void *in_data, uint8_t out_len, void *out_data) {
    memcpy(&oled_sync, in_data, sizeof(oled_sync));
}

void keyboard_post_init_user(void) {
    transaction_register_rpc(USER_OLED_SYNC, oled_sync_handler);
}

// 左手側: 値が変わったら (最短 100ms 間隔で)、変わらなくても 1秒ごとに右手へ送る
void housekeeping_task_user(void) {
    if (!is_keyboard_master()) return;
    static uint32_t    last_sent;
    static oled_sync_t sent;
    oled_sync_t now = {
        .x   = keyball.last_mouse.x,
        .y   = keyball.last_mouse.y,
        .cpi = keyball_get_cpi(),
#    ifdef POINTING_DEVICE_AUTO_MOUSE_ENABLE
        .aml = (get_auto_mouse_enable() ? 0x80 : 0) | (get_auto_mouse_timeout() / 10),
#    endif
    };
    uint32_t elapsed = timer_elapsed32(last_sent);
    if ((memcmp(&now, &sent, sizeof(now)) && elapsed >= 100) || elapsed >= 1000) {
        if (transaction_rpc_send(USER_OLED_SYNC, sizeof(now), &now)) sent = now;
        last_sent = timer_read32();
    }
}

// 左手 (マスター): キーとレイヤ
void oledkit_render_info_user(void) {
    uint16_t kc = keyball.last_kc;
    begin_screen();

    put_P(PSTR("Key"));
    end_line();

    // 押したキーの位置
    put('\xB8');
    put_hex(keyball.last_pos.row);
    put('\xB9');
    put_hex(keyball.last_pos.col);
    end_line();

    // 押したキーの動作 (2行まで。短いときも2行分使って下の行の位置を固定)
    uint8_t start = oled_row;
    oled_wrap = 1;
    put_tap(kc);
    oled_wrap = 0;
    end_line();
    if (oled_row < start + 2) end_line();

    // レイヤ 1〜4 (MOUSE〜ADJUST1)
    put('L');
    for (uint8_t i = _MOUSE; i <= _ADJUST1; i++) put(layer_state_is(i) ? '0' + i : '\xB0');
    end_line();

#    ifdef RGBLIGHT_ENABLE
    // LED 発光パターン: パターン名の先頭4文字 + パターン内の番号(0始まり)。消灯中は "OFF"
    if (!rgblight_is_enabled()) {
        put_P(PSTR("OFF"));
    } else {
        uint8_t m = rgblight_get_mode();
        uint8_t i = sizeof(rgb_mode_base) - 1;
        while (i > 0 && m < pgm_read_byte(&rgb_mode_base[i])) i--;
        oled_wrap = 0;
        for (uint8_t k = 0; k < 4; k++) {
            char c = pgm_read_byte(&rgb_mode_name[i][k]);
            put(c ? c : ' ');
        }
        put('0' + m - pgm_read_byte(&rgb_mode_base[i]));
    }
    end_line();
#    endif

    put_P(PSTR("-----"));
    end_line();
    clear_rest();
}

// 右手 (スレーブ): トラックボール (oledkit が右手側で呼ぶ関数)
void oledkit_render_logo_user(void) {
    begin_screen();

    put_P(PSTR("Ball"));
    end_line();
    put_num(oled_sync.x, 5);
    end_line();
    put_num(oled_sync.y, 5);
    end_line();

    put_P(PSTR("\xBC\xBD"));   // CPI
    end_line();
    put_num(oled_sync.cpi, 3);
    put_P(PSTR("00"));
    end_line();

#    ifdef POINTING_DEVICE_AUTO_MOUSE_ENABLE
    put_P(PSTR("\xC2\xC3"));   // AML
    put_P((oled_sync.aml & 0x80) ? PSTR("\xB2\xB3") : PSTR("\xB4\xB5"));   // ON / OFF
    end_line();
    put_num(oled_sync.aml & 0x7F, 3);
    put('0');
    end_line();
#    endif
    clear_rest();
}
