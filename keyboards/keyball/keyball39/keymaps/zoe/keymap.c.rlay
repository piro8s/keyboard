/*********************************
 * 猫のアニメーション (左右とも 14〜16行目) *
 *********************************
 * 打っていないときは座ってしっぽを振り、打つと歩き、速く打つと走る (猫はその場で足踏みし、地面が流れる)。
 * 左手: キー入力で動く。Ctrl を押している間はしゃがんで忍び歩き、スペースでジャンプ。
 * 右手: ボールを転がすと動く (右手のセンサーの移動量で判定)。
 * 左手は 1〜13行目が文字、右手は 1〜2行目が CPI。14〜16行目が猫 (ジャンプ中は 14行目も使う)。
 * 座ったまま 10秒たつと動きを止める (OLED は表示が変わると消灯タイマーが延びるので、
 * 動かし続けると画面がずっと消えなくなるため)。
 *
 * 絵は 16x12 ドット。OLED のメモリと同じ「縦8ドット = 1バイト」の形で持ち、そのまま書き込む (容量節約)。
 *   上の段: 15行目 (y=112〜119) の bit3〜7 に絵の 1〜5行目
 *   下の段: 16行目 (y=120〜127) の bit0〜6 に絵の 6〜12行目、bit7 は地面
 * ジャンプ中は 1行 (8ドット) 上 (14〜15行目) に描く。
 */
#define CAT_X 8    // 猫の左端 (ドット)。幅16ドットなので画面(32ドット)の中央
enum { CAT_SIT = 0, CAT_WALK = 2, CAT_RUN = 4, CAT_CROUCH = 6 };

static const uint8_t cat_up[][16] PROGMEM = {   // 上の段 (同じ形は共有)
    {0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0xF8, 0xB0, 0xE0, 0xB0, 0xF8, 0x00, 0x00},
    {0x40, 0x80, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0xF8, 0xB0, 0xE0, 0xB0, 0xF8},
    {0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00},
};
static const uint8_t cat_lo[8][16] PROGMEM = {   // 下の段
    {0x00, 0x02, 0x0C, 0x10, 0x20, 0x20, 0x60, 0x70, 0x3C, 0x7E, 0x7F, 0x3F, 0x7F, 0x7E, 0x00, 0x00},   // 座る1
    {0x04, 0x08, 0x10, 0x10, 0x20, 0x20, 0x60, 0x70, 0x3C, 0x7E, 0x7F, 0x3F, 0x7F, 0x7E, 0x00, 0x00},   // 座る2 (しっぽが下がる)
    {0x00, 0x00, 0x3F, 0x0F, 0x3F, 0x0F, 0x0F, 0x0F, 0x0F, 0x0F, 0x3F, 0x0F, 0x3F, 0x07, 0x01, 0x00},   // 歩く1
    {0x00, 0x00, 0x2F, 0x1F, 0x0F, 0x1F, 0x2F, 0x0F, 0x2F, 0x1F, 0x0F, 0x1F, 0x2F, 0x07, 0x01, 0x00},   // 歩く2
    {0x20, 0x10, 0x0F, 0x0F, 0x0F, 0x0F, 0x0F, 0x0F, 0x0F, 0x0F, 0x0F, 0x0F, 0x0F, 0x07, 0x11, 0x20},   // 走る1 (ジャンプ中もこれ)
    {0x00, 0x00, 0x0F, 0x1F, 0x2F, 0x0F, 0x0F, 0x0F, 0x0F, 0x2F, 0x1F, 0x0F, 0x0F, 0x07, 0x01, 0x00},   // 走る2
    {0x04, 0x44, 0x34, 0x78, 0x38, 0x78, 0x38, 0x78, 0x38, 0x78, 0x38, 0x7F, 0x36, 0x7C, 0x36, 0x1F},   // しゃがむ1
    {0x04, 0x04, 0x74, 0x38, 0x78, 0x38, 0x78, 0x38, 0x78, 0x38, 0x78, 0x3F, 0x76, 0x3C, 0x76, 0x1F},   // しゃがむ2
};

static struct {
    uint8_t e;      // 元気 (打鍵・ボールで増え、時間で減る)。0: 座る, 1〜30: 歩く, 31〜: 走る
    uint8_t t;      // コマ送りのカウンタ
    uint8_t g;      // 地面の模様の位置 (歩くとき・走るときに流れる)
    uint8_t idle;   // 座っている時間 (コマ数)
    uint8_t jump;   // ジャンプの残りコマ数
} cat;

// 左手のキー入力で呼ぶ (process_record_user から)
static void cat_kick(bool jump) {
    cat.e = cat.e > 55 ? 60 : cat.e + 5;
    if (jump && !cat.jump) cat.jump = 6;
}

static void render_cat(bool crouch) {
    // OLED の描画は分割キーボードでは 50ms ごと (OLED_UPDATE_INTERVAL) なので、呼ばれるたびに1コマ進める (1秒20コマ)
    uint8_t t = ++cat.t;
    if (cat.e && (t & 1)) cat.e--;

    uint8_t f;                                   // 絵の番号
    if (crouch) {
        f = CAT_CROUCH + ((t >> 3) & 1);
        if (cat.e && !(t & 3)) cat.g++;
    } else if (cat.jump) {
        cat.jump--;
        f = CAT_RUN;
        cat.g++;
    } else if (cat.e > 30) {
        f = CAT_RUN + ((t >> 1) & 1);
        cat.g++;
    } else if (cat.e) {
        f = CAT_WALK + ((t >> 2) & 1);
        if (t & 1) cat.g++;
    } else {
        f = CAT_SIT + ((t >> 4) & 1);
        // 座ったまま 10秒 (200コマ) たったら、絵を描き替えない (OLED が消灯できるように)
        if (cat.idle >= 200) return;
        cat.idle++;
    }
    if (f >= CAT_WALK) cat.idle = 0;

    // 14〜16行目 (y=104〜127) の 32列 x 3行 をまとめて作って、1回で書き込む。
    // 8〜13行目は文字も絵も書かないので、最初に消えたまま (ジャンプ中だけ 14行目を使う)
    const uint8_t *up = cat_up[f < CAT_WALK ? 0 : f < CAT_CROUCH ? 1 : 2];
    const uint8_t *lo = cat_lo[f];
    uint8_t buf[3 * 32] = {0};
    uint8_t *b = cat.jump ? buf : buf + 32;      // 上の段を書く位置 (ジャンプ中は1行上)
    for (uint8_t x = 0; x < 32; x++) {
        uint8_t c = x - CAT_X;
        if (c < 16) {
            b[x]      = pgm_read_byte(&up[c]);
            b[x + 32] = pgm_read_byte(&lo[c]);
        }
        if (f < CAT_WALK || ((x + cat.g) & 3)) buf[64 + x] |= 0x80;   // 地面 (座っているときは実線、動いているときは流れる点線)
    }
    oled_set_cursor(0, 13);
    oled_write_raw((const char *)buf, sizeof(buf));
}

// 容量のため無効 (斑点には効かなかった)
// // 起動から 1秒後に一度だけ画面全体を消して送り直す
// // (右手の OLED の端に、起動時のゴミと思われる点が残るため。文字や猫は次の描画で書き直される)
// static void oled_refresh_once(void) {
//     static bool done;
//     if (!done && timer_read() > 1000) {
//         oled_clear();
//         done = true;
//     }
// }

// 左手 (マスター): キーとレイヤ
void oledkit_render_info_user(void) {
    // oled_refresh_once();   // 容量のため無効
    uint16_t kc = keyball.last_kc;
    begin_screen();

    put_P(PSTR("Key"));
    end_line();

    // 押したキーの位置
    put('\xB8');
    put_hex(keyball.last_pos.row);
    put('\xB9');
    put_hex(keyball.last_pos.col);
    end_line();

    // 押したキーの動作 (2行まで。短いときも2行分使って下の行の位置を固定)
    uint8_t start = oled_row;
    oled_wrap = 1;
    put_tap(kc);
    oled_wrap = 0;
    end_line();
    if (oled_row < start + 2) end_line();

    // レイヤ 1〜4 (MOUSE〜ADJUST1)
    put('L');
    for (uint8_t i = _MOUSE; i <= _ADJUST1; i++) put(layer_state_is(i) ? '0' + i : '\xB0');
    end_line();


#    ifdef POINTING_DEVICE_AUTO_MOUSE_ENABLE
    // 自動マウス (AML) の ON/OFF とタイムアウト
    put_P(PSTR("\xC2\xC3"));   // AML
    put_P(get_auto_mouse_enable() ? PSTR("\xB2\xB3") : PSTR("\xB4\xB5"));   // ON / OFF
    end_line();
    put_num(get_auto_mouse_timeout() / 10, 3);   // 10ms単位
    put('0');
    end_line();
#    endif

    while (oled_row < 13) end_line();          // 13行目まで空白 (14〜16行目は猫)
    render_cat(get_mods() & MOD_MASK_CTRL);    // 14〜16行目: 猫 (Ctrl でしゃがむ)
}

// 右手 (スレーブ): ボール・CPI・LED (oledkit が右手側で呼ぶ関数)
// 左手から送る通信は使わない (ボール操作中に値が壊れたため)。右手が自分で持っている情報だけを表示する
void oledkit_render_logo_user(void) {
    // oled_refresh_once();   // 容量のため無効
    begin_screen();

    // ボールの移動量: 右手のセンサーの値 (this_motion) をそのまま表示。
    // 左手が 4ms ごとに取りに来て 0 に戻すので、描画時 (50ms ごと) に見えた値を覚えておき、
    // 猫が座ったら (しばらく動きがなかったら) 0 にする。PC へ送る値とは単位が違う (センサーの生の値)
    static int16_t bx, by;
    bool moved = keyball.this_motion.x || keyball.this_motion.y;
    if (moved) {
        bx = keyball.this_motion.x;
        by = keyball.this_motion.y;
    } else if (!cat.e) {
        bx = by = 0;
    }
    put_P(PSTR("Ball"));
    end_line();
    put_num(bx, 5);
    end_line();
    put_num(by, 5);
    end_line();

    put_P(PSTR("\xBC\xBD"));   // CPI
    end_line();
    put_num(keyball_get_cpi(), 3);   // 100単位
    put_P(PSTR("00"));
    end_line();

    uint8_t start;
#    ifdef RGBLIGHT_ENABLE
    // LED 発光パターン: パターン名 + パターン内の番号(0始まり)。2行まで使う (短いときも2行分使って下の行の位置を固定)。消灯中は "OFF"
    start = oled_row;
    if (!rgblight_is_enabled()) {
        put_P(PSTR("OFF"));
    } else {
        uint8_t m = rgblight_get_mode();
        uint8_t i = sizeof(rgb_mode_base) - 1;
        while (i > 0 && m < pgm_read_byte(&rgb_mode_base[i])) i--;
        oled_wrap = 1;
        put_P(rgb_mode_name[i]);
        put(' ');
        put('0' + m - pgm_read_byte(&rgb_mode_base[i]));
        oled_wrap = 0;
    }
    end_line();
    if (oled_row < start + 2) end_line();
#    endif

    while (oled_row < 13) end_line();          // 13行目まで空白 (14〜16行目は猫)
    // 猫: 右手のボールが動いている間は元気が増える
    // 右手の移動量は左手が 4ms ごとに取りに来て 0 に戻すので、描画時 (50ms ごと) には一部しか見えない。
    // そのぶん 1回見えたときの増え方を大きくする (+2 だと歩き出しが鈍かった)
    if (moved) cat.e = cat.e > 50 ? 60 : cat.e + 10;
    render_cat(false);
}

