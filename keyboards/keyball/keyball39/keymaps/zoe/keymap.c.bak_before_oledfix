// Layers Setting
#ifdef POINTING_DEVICE_AUTO_MOUSE_ENABLE
// MOUSE/Alt キーのタップで MOUSE に入っている間は AML を一時停止し、MOUSE を抜けたら元に戻す
static bool aml_suspended = false;  // true: 一時停止中
static bool aml_pref      = false;  // 一時停止前の AML の ON/OFF（復帰時に戻す値）
#endif

layer_state_t layer_state_set_user(layer_state_t state) {
    // Auto enable scroll mode when the highest layer is MOUSE
    keyball_set_scroll_mode(get_highest_layer(state) == _ADJUST2);  // highestはADJUST2になる気がするけど、動くのかね...
#ifdef POINTING_DEVICE_AUTO_MOUSE_ENABLE
    // MOUSE レイヤを抜けたら、一時停止していた AML を元の設定に戻す
    if (aml_suspended && !layer_state_cmp(state, _MOUSE)) {
        aml_suspended = false;
        set_auto_mouse_enable(aml_pref);
    }
#endif
    return update_tri_layer_state(state, _NUMBERS, _FUNCTIONS, _ADJUST1);;
}

// 全角/半角切り替え用(Mac)
bool TOG_STATUS_ZENHAN = false;   // true: 全角, false: 半角

// キーレイアウト(Windows/Mac)切り替え用
bool TOG_STATUS_WINMAC = false;   // true: Mac, false: Windows

#ifdef POINTING_DEVICE_AUTO_MOUSE_ENABLE
// 自動マウスレイヤ中に押してもレイヤを解除しないキー
// (MS_BTN*, 標準の修飾キー, SCRL_MO は QMK/keyball 側で処理済み)
bool is_mouse_record_user(uint16_t keycode, keyrecord_t *record) {
    if (!layer_state_is(_MOUSE)) return false;   // MOUSEレイヤ以外では通常キーとして扱う
    switch (keycode) {
        case KBC_RST:  case KBC_SAVE:
        case CPI_I100: case CPI_D100: case CPI_I1K: case CPI_D1K:
        case AML_TO:   case AML_I50:  case AML_D50:
        case WM_WBAK:  case WM_WFWD:
        case WM_LCTL:  case WM_LGUI:  case KC_LSFT: case KC_LALT:
        case MS_BTN1:  case MS_BTN2:  case SCRL_MO:
        case KC_C:     case KC_SPC:   case KC_BSPC: case KC_ENT: case NM_SPC:
        case MS_PRCS_M:
            return true;
    }
    return false;
}
#endif

// Custom Keycodes Setting
bool process_record_user(uint16_t keycode, keyrecord_t *record) {
  switch (keycode) {
    /*****************************
     * Keymap Layer              *
     *****************************/
    // MAIN
    case MAIN:
      if (record->event.pressed) {
        // set_single_persistent_default_layer(_MAIN);
        layer_move(_MAIN);  // MAINだけにする（恒久）
      }
      return false;
      break;
    // // NUMBERS
    // case NUMS:
    //   if (record->event.pressed) {
    //     layer_on(_NUMBERS);
    //     update_tri_layer(_NUMBERS, _FUNCTIONS, _ADJUST1);
    //   } else {
    //     layer_off(_NUMBERS);
    //     update_tri_layer(_NUMBERS, _FUNCTIONS, _ADJUST1);
    //   }
    //   return false;
    //   break;
    // // FUNCTIONS
    // case FUNCS:
    //   if (record->event.pressed) {
    //     layer_on(_FUNCTIONS);
    //     update_tri_layer(_NUMBERS, _FUNCTIONS, _ADJUST1);
    //   } else {
    //     layer_off(_FUNCTIONS);
    //     update_tri_layer(_NUMBERS, _FUNCTIONS, _ADJUST1);
    //   }
    //   return false;
    //   break;
    // // MOUSE
    // case MOUSE:
    //   if (record->event.pressed) layer_move(_MOUSE);  // MOUSEだけにする（恒久）
    //   return false;
    //   break;
    // Tap: MOUSEへ移動 / Hold: Alt (LALT_T)
    case AT_MS:
      if (record->tap.count) {
        if (record->event.pressed) {
#ifdef POINTING_DEVICE_AUTO_MOUSE_ENABLE
          if (!aml_suspended) {                 // 手動で MOUSE に入る間は AML を一時停止
            aml_pref      = get_auto_mouse_enable();
            aml_suspended = true;
          }
          set_auto_mouse_enable(false);
#endif
          layer_move(_MOUSE);
        }
        return false;
      }
      break;
    // // LT(_NUMS._MAIN)
    // case LT_NM_MN:
    //   if (record->tap.count) {
    //     if (record->event.pressed) layer_move(_MAIN);
    //   }
    //   return false;
    //   break;

    /**********************************
     * Set Key Layout for Windows/Mac *
     **********************************/
    // Set Windows Layout
    case SET_WIN:
      if (record->event.pressed) {
        TOG_STATUS_WINMAC = false;    // Change Key Layout for Windows
      }
      return false;
      break;
    // Set Mac Layout
    case SET_MAC:
      if (record->event.pressed) {
        TOG_STATUS_WINMAC =  true;    // Change Key Layout for Mac
      }
      return false;
      break;

    /*****************************
     * Same Key on Windows & Mac *
     *****************************/
    // Winows:全角/半角キー, Mac:かなキー/英数キー
    case WM_ZHTG:
      if (record->event.pressed) {
        // Shift, Ctrlが押されていても、全角/半角の切り替えを行えるようにする
        uint8_t mods = get_mods();
        clear_mods();
        // Windows/Macのキーマップが切り替わっているか判断し、全角/英数切替する
        // if(!TOG_STATUS_WINMAC) SEND_STRING(SS_LALT("`")); // for Windows
        if(!TOG_STATUS_WINMAC)    tap_code(JP_ZKHK);   // for Windows
        else {                                        // for Mac
          TOG_STATUS_ZENHAN = !TOG_STATUS_ZENHAN;
          if (TOG_STATUS_ZENHAN) tap_code(KC_LNG1);   // KANA: 全角
          else                   tap_code(KC_LNG2);   // EISU：半角
        }
        set_mods(mods);
        send_keyboard_report();
      }
      return false;
      break;
    // Winows:Windowsキー, Mac:Controlキー
    case WM_LGUI:
      if (record->event.pressed) {
        if(!TOG_STATUS_WINMAC) register_code(KC_LGUI);    // for Windows
        else                   register_code(KC_LCTL);    // for Mac
      }
      else {
        if(!TOG_STATUS_WINMAC) unregister_code(KC_LGUI);  // for Windows
        else                   unregister_code(KC_LCTL);  // for Mac
      }
      return false;
      break;
    // Windows: Control, Mac: Command
    case WM_LCTL:
      if (record->event.pressed) {
        if(!TOG_STATUS_WINMAC) register_code(KC_LCTL);    // for Windows
        else                   register_code(KC_LGUI);    // for Mac
      }
      else {
        if(!TOG_STATUS_WINMAC) unregister_code(KC_LCTL);  // for Windows
        else                   unregister_code(KC_LGUI);  // for Mac
      }
      return false;
      break;
    /// Win:Alt+←, Mac:Command+[
    case WM_WBAK:
      if (record->event.pressed) {
        if(!TOG_STATUS_WINMAC) tap_code16(A(KC_LEFT));    // for Windows
        else                   tap_code16(G(KC_RBRC));    // for Mac
      }
      return false;
      break;
    // Win:Alt+→, Mac:Command+]
    case WM_WFWD:
      if (record->event.pressed) {
        if(!TOG_STATUS_WINMAC) tap_code16(A(KC_RGHT));    // for Windows
        else                  tap_code16(G(KC_BSLS));    // for Mac
      }
      return false;
      break;

    /*****************************
     * JIS One-Symbol Keys       *
     *****************************/
    // Always JIS (
    case JS_LPRN:
      if (record->event.pressed) {
        bool is_mod_shift = (keyboard_report->mods & MOD_BIT(KC_LSFT));  // shifted
        if (is_mod_shift) tap_code(KC_8);
        else              tap_code16(S(KC_8));
        // else              {register_code16(S(KC_8));unregister_code16(S(KC_8));}
        // else              {register_mods(MOD_BIT(KC_LSFT));register_code(KC_8);unregister_code(KC_8);unregister_mods(MOD_BIT(KC_LSFT));}
      }
      return false;
      break;
    // Always JIS )
    case JS_RPRN:
      if (record->event.pressed) {
        bool is_mod_shift = (keyboard_report->mods & MOD_BIT(KC_LSFT));  // shifted
        if (is_mod_shift) tap_code(KC_9);
        else              tap_code16(S(KC_9));
      }
      return false;
      break;
    // Always JIS {
    case JS_LCBR:
      if (record->event.pressed) {
        bool is_mod_shift = (keyboard_report->mods & MOD_BIT(KC_LSFT));  // shifted
        if (is_mod_shift) tap_code(KC_RBRC);
        else              tap_code16(S(KC_RBRC));
      }
      return false;
      break;
    // Always JIS }
    case JS_RCBR:
      if (record->event.pressed) {
        bool is_mod_shift = (keyboard_report->mods & MOD_BIT(KC_LSFT));  // shifted
        if (is_mod_shift) tap_code(KC_BSLS);
        else              tap_code16(S(KC_BSLS));
      }
      return false;
      break;
    // Always JIS [
    case JS_LBRC:
      if (record->event.pressed) {
        bool is_mod_shift = (keyboard_report->mods & MOD_BIT(KC_LSFT));  // shifted
        if (is_mod_shift) unregister_mods(MOD_BIT(KC_LSFT));
        tap_code(KC_RBRC);
        if (is_mod_shift)   register_mods(MOD_BIT(KC_LSFT));
      }
      return false;
      break;
    // Always JIS ]
    case JS_RBRC:
      if (record->event.pressed) {
        bool is_mod_shift = (keyboard_report->mods & MOD_BIT(KC_LSFT));  // shifted
        if (is_mod_shift) unregister_mods(MOD_BIT(KC_LSFT));
        tap_code(KC_BSLS);
        if (is_mod_shift)   register_mods(MOD_BIT(KC_LSFT));
      }
      return false;
      break;
    // Always JIS _
    case JS_UNDS:
      if (record->event.pressed) {
        bool is_mod_shift = (keyboard_report->mods & MOD_BIT(KC_LSFT));  // shifted
        if (is_mod_shift) unregister_mods(MOD_BIT(KC_LSFT));
        if(!TOG_STATUS_WINMAC) tap_code16(S(KC_INT1));  // for Windows
        else                   tap_code16(S(KC_MINS));  // for Mac
        if (is_mod_shift)   register_mods(MOD_BIT(KC_LSFT));
      }
      return false;
      break;

    /*****************************
     * like US key on JIS leyout *
     *****************************/
    // ; and : on JIS
    case JU_SCLN:
      if (record->event.pressed) {
        if (keyboard_report->mods & MOD_BIT(KC_LSFT)) {  // shifted
          unregister_mods(MOD_BIT(KC_LSFT));
          tap_code(JP_COLN);     // :
        register_mods(MOD_BIT(KC_LSFT));
        } else {
          tap_code(JP_SCLN);     // ;
        }
      }
      return false;
      break;
    // ' and " on JIS
    case JU_QUOT:
      if (record->event.pressed) {
        if (keyboard_report->mods & MOD_BIT(KC_LSFT)) {  // shifted
          tap_code(JP_2);      // "
        } else {
          tap_code16(S(JP_7));  // '
        }
      }
      return false;
      break;

    /*****************************
     * Original key              *
     *****************************/
    // // - and =
    // case MY_CLCME:
    //   if (record->event.pressed) {
    //     if (keyboard_report->mods & MOD_BIT(KC_LSFT)) {  // shifted
    //       tap_code(KC_PEQL);     // =
    //     } else {
    //       tap_code(KC_PMNS);     // -
    //     }
    //   }
    //   return false;
    //   break;
    // + and *
    case MY_CLCPB:
      if (record->event.pressed) {
        if (keyboard_report->mods & MOD_BIT(KC_LSFT)) {  // shifted
          tap_code(KC_PAST);     // *
        } else {
          tap_code(KC_PPLS);     // +
        }
      }
      return false;
      break;

    /*********************************
     * M-od, T-ap                    *
     *********************************/
    // CTL_SCLN,            // Tap:Move Layer to _MOUSE, Hold:Layer On _NUMBERS
    case CTL_SCLN:
      if (record->tap.count) return process_record_user(JU_SCLN, record);  // タップ時はJU_SCLNの処理に任せる
      break;

    /*********************************
     * Mouse key                     *
     *********************************/
    // Mouse Precision Mode(CPI:100)
    case MS_PRCS_M:
      if (record->event.pressed) {
        keyball_set_cpi(keyball_get_cpi() == DEFAULT_CPI ? PRECISION_CPI : DEFAULT_CPI);  // CPI切替
      }
      return false;
      break;
    // Momentary scroll mode
    case SCRL_MO:
      if (record->event.pressed)  keyball_set_cpi(PRECISION_CPI);   // スクロール中はCPI 100
      else                        keyball_set_cpi(DEFAULT_CPI);     // 離したら元に戻す
      return true;
      break;
    // Keyball configuration: reset to default
#   ifdef POINTING_DEVICE_AUTO_MOUSE_ENABLE
    case KBC_RST:
      if (!record->event.pressed) {
        if (aml_suspended) aml_pref = true;                       // 手動MOUSE中なら、抜けた後に戻す値もONに
        set_auto_mouse_enable(true);                              // ライブラリが押下時にOFFにした後、ONに戻す
        keyrecord_t save = {.event = {.pressed = true, .time = timer_read()}};
        process_record_kb(KBC_SAVE, &save);                        // ライブラリのKBC_SAVE処理でEEPROMへ保存
        if (aml_suspended) set_auto_mouse_enable(false);          // 保存後は一時停止に戻す
      }
      return true;                                                // 押下時のリセット処理はライブラリに任せる
    // 設定保存: 手動MOUSE中は、一時停止中のOFFではなく元の設定(aml_pref)を保存する
    //   ライブラリは押下時に保存するので、押下時に元の設定へ戻し、離した時に一時停止へ戻す
    case KBC_SAVE:
      if (aml_suspended) set_auto_mouse_enable(record->event.pressed ? aml_pref : false);
      return true;
    // AML ON/OFF: 手動MOUSE中(一時停止中)は、MOUSEを抜けた後に戻す設定の方を切り替える
    case AML_TO:
      if (aml_suspended) {
        if (record->event.pressed) aml_pref = !aml_pref;
        return false;
      }
      return true;
#   endif
    /*********************************
     * Microsoft Teams short cut key *
     *********************************/
    // Mic Mute on Microsoft Teams: Control + Shift + M
    case TMS_MICMT:
    if (record->event.pressed) {
      SEND_STRING(SS_LCTL(SS_LSFT("m")));
    }
    return false;
    break;

    /*********************************
     * LED RGM Pattern.              *
     *********************************/
    case RGB_M_P:  if (record->event.pressed) rgblight_mode(RGBLIGHT_MODE_STATIC_LIGHT);    return false;
    case RGB_M_B:  if (record->event.pressed) rgblight_mode(RGBLIGHT_MODE_BREATHING);       return false;
    case RGB_M_R:  if (record->event.pressed) rgblight_mode(RGBLIGHT_MODE_RAINBOW_MOOD);    return false;
    case RGB_M_SW: if (record->event.pressed) rgblight_mode(RGBLIGHT_MODE_RAINBOW_SWIRL);   return false;
    case RGB_M_SN: if (record->event.pressed) rgblight_mode(RGBLIGHT_MODE_SNAKE);           return false;
    case RGB_M_K:  if (record->event.pressed) rgblight_mode(RGBLIGHT_MODE_KNIGHT);          return false;
    case RGB_M_X:  if (record->event.pressed) rgblight_mode(RGBLIGHT_MODE_CHRISTMAS);       return false;
    case RGB_M_G:  if (record->event.pressed) rgblight_mode(RGBLIGHT_MODE_STATIC_GRADIENT); return false;
    case RGB_M_T:  if (record->event.pressed) rgblight_mode(RGBLIGHT_MODE_RGB_TEST);        return false;
    case RGB_M_TW: if (record->event.pressed) rgblight_mode(RGBLIGHT_MODE_TWINKLE);         return false;

  // End of switch(keycode)
  }
  return true;
}

#ifdef OLED_ENABLE

#    include "lib/oledkit/oledkit.h"

extern const char code_to_name[] PROGMEM;   // lib/keyball/keyball.c

static char hex1(uint8_t v) {
    v &= 0x0F;
    return v < 10 ? '0' + v : 'A' + v - 10;
}

// 基本キーコード(下位8bit)を名前で表示。名前がないものは16進2桁
static void render_basic_key(uint8_t kc) {
    if (kc >= KC_ENTER && kc <= KC_SPACE) {
        static const char names[][4] PROGMEM = {"ENT", "ESC", "BSP", "TAB", "SPC"};
        oled_write_P(names[kc - KC_ENTER], false);
    } else if (kc >= KC_A && kc < KC_A + 53) {
        oled_write_char(pgm_read_byte(code_to_name + kc - KC_A), false);
    } else {
        oled_write_char(hex1(kc >> 4), false);
        oled_write_char(hex1(kc), false);
    }
}

// 1段目: "Key|R3C4 4328 LT3:ENT" のように 位置・キーコード(16進4桁)・キーの意味 を表示
static void render_keyinfo_zoe(void) {
    uint16_t kc = keyball.last_kc;
    oled_write_P(PSTR("Key\xB1\xB8"), false);
    oled_write_char(hex1(keyball.last_pos.row), false);
    oled_write_char('\xB9', false);
    oled_write_char(hex1(keyball.last_pos.col), false);
    oled_write_char(' ', false);
    for (int8_t sh = 12; sh >= 0; sh -= 4) oled_write_char(hex1(kc >> sh), false);
    oled_write_char(' ', false);
    if (IS_QK_MOD_TAP(kc)) {                 // MT(mod, kc)
        oled_write_P(PSTR("MT:"), false);
        render_basic_key(kc);
    } else if (IS_QK_LAYER_TAP(kc)) {        // LT(layer, kc)
        oled_write_P(PSTR("LT"), false);
        oled_write_char(hex1(QK_LAYER_TAP_GET_LAYER(kc)), false);
        oled_write_char(':', false);
        render_basic_key(kc);
    } else if (IS_QK_MODS(kc)) {             // S(kc) など修飾付き
        oled_write_P(PSTR("M+"), false);
        render_basic_key(kc);
    } else if (IS_QK_USER(kc)) {             // zoe のカスタムキー
        oled_write_P(PSTR("USR"), false);
        render_basic_key(kc - QK_USER);
    } else if (IS_QK_KB(kc)) {               // Keyball のキー(CPI_*, AML_* など)
        oled_write_P(PSTR("KB"), false);
        render_basic_key(kc - QK_KB);
    } else if (kc < 0x100) {
        render_basic_key(kc);
    }
    oled_advance_page(true);
}

void oledkit_render_info_user(void) {
    render_keyinfo_zoe();
    keyball_oled_render_ballinfo();
    keyball_oled_render_layerinfo();
}
