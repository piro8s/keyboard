#if defined(OLED_ENABLE) && defined(RGBLIGHT_ENABLE)
// LED発光パターン表示用テーブル（モード番号の小さい順）
static const uint8_t rgb_mode_base[] PROGMEM = {
    RGBLIGHT_MODE_STATIC_LIGHT, RGBLIGHT_MODE_BREATHING, RGBLIGHT_MODE_RAINBOW_MOOD,
    RGBLIGHT_MODE_RAINBOW_SWIRL, RGBLIGHT_MODE_SNAKE, RGBLIGHT_MODE_KNIGHT,
    RGBLIGHT_MODE_CHRISTMAS, RGBLIGHT_MODE_STATIC_GRADIENT, RGBLIGHT_MODE_RGB_TEST,
    RGBLIGHT_MODE_ALTERNATING, RGBLIGHT_MODE_TWINKLE,
};
static const char rgb_mode_name[][9] PROGMEM = {
    "STATIC", "BREATH", "RAINBOW", "SWIRL", "SNAKE", "KNIGHT",
    "XMAS", "GRADIENT", "RGBTEST", "ALTERNAT", "TWINKLE",
};

// "LED:BREATH 1" のように パターン名 + パターン内の番号(0始まり) を1行で表示
static void render_rgb_mode(void) {
    oled_write_P(PSTR("LED:"), false);
    if (!rgblight_is_enabled()) {
        oled_write_P(PSTR("OFF"), false);
        return;
    }
    uint8_t m = rgblight_get_mode();
    uint8_t i = sizeof(rgb_mode_base) - 1;
    while (i > 0 && m < pgm_read_byte(&rgb_mode_base[i])) i--;
    oled_write_P(rgb_mode_name[i], false);
    oled_write_char(' ', false);
    oled_write_char('0' + (m - pgm_read_byte(&rgb_mode_base[i])), false);   // パターン内の番号(0始まり)
}

// 右手(スレーブ)：ロゴ3行 + 4行目にLED発光パターン
void oledkit_render_logo_user(void) {
    char ch = 0x80;
    for (int y = 0; y < 3; y++) {
        oled_write_P(PSTR("  "), false);
        for (int x = 0; x < 16; x++) {
            oled_write_char(ch++, false);
        }
        oled_advance_page(false);
    }
    render_rgb_mode();
    oled_advance_page(true);
}
