/*********************************
 * 修飾キー (mod-tap) の判定      *
 *********************************
 * PERMISSIVE_HOLD だけだと、修飾キーを素早く押して「次のキーより先に修飾キーを離す」とタップ扱いになり、
 * Shift+K が "zk"、Ctrl+C が "ac" になる。そこで mod-tap (Ctrl/Shift/Alt) は
 * 「他のキーを押した瞬間に修飾キー」と判定する。layer-tap (Spc/NUM, Ent/FNC) は今までどおり。
 * ただし文字を打っている最中(直前のキーから MOD_FLOW_TERM 未満)に押したときは今までどおりの判定にして、
 * 「…ざ」「…か」のように z や a の直後に次の文字を重ねて打っても Shift/Ctrl にならないようにする。
 * (QMK の Flow Tap 機能は約840バイト必要で容量に入らないため、同じ考え方を簡易的に実装)
 */
#define MOD_FLOW_TERM 150   // 直前のキーからこの時間(ms)未満に押した mod-tap は今までどおりの判定
static uint16_t last_press_time;   // 直前にキーを押した時刻 (process_record_user で更新)

bool get_hold_on_other_key_press(uint16_t keycode, keyrecord_t *record) {
    // record は mod-tap を押したときの記録。直前のキーから十分間が空いていれば修飾キーとして使う意図とみなす
    return IS_QK_MOD_TAP(keycode) && TIMER_DIFF_16(record->event.time, last_press_time) >= MOD_FLOW_TERM;
}

#ifdef POINTING_DEVICE_AUTO_MOUSE_ENABLE
// 自動マウスレイヤ中に押してもレイヤを解除しないキー
// (MS_BTN*, 標準の修飾キー, SCRL_MO は QMK/keyball 側で処理済み)
bool is_mouse_record_user(uint16_t keycode, keyrecord_t *record) {
    if (!layer_state_is(_MOUSE)) return false;   // MOUSEレイヤ以外では通常キーとして扱う
    switch (keycode) {
        case KBC_RST:  case KBC_SAVE:
        case CPI_I100: case CPI_D100: case CPI_I1K: case CPI_D1K:
        case AML_TO:   case AML_I50:  case AML_D50:
        case WM_WBAK:  case WM_WFWD:
        case WM_LCTL:  case WM_LGUI:  case KC_LSFT: case KC_LALT:
        case MS_BTN1:  case MS_BTN2:  case SCRL_MO:
        case KC_C:     case KC_SPC:   case KC_BSPC: case KC_ENT: case NM_SPC:
        case MS_PRCS_M:
            return true;
    }
    return false;
}
#endif

